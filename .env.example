# Environment Variables for BlazeUp
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_APP_ENV=development

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Email Service (if using external service)
VITE_EMAIL_SERVICE_API_KEY=your_email_service_api_key_here

# Analytics (optional)
VITE_ANALYTICS_ID=your_analytics_id_here

# Social Media Links
VITE_LINKEDIN_URL=https://www.linkedin.com/company/blazeupapp
VITE_TWITTER_URL=https://twitter.com/blazeupapp
VITE_INSTAGRAM_URL=https://instagram.com/blazeupapp